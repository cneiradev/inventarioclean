# ---- LOCAL (perfil local: H2 en memoria, sin Supabase) ----

# Activa el perfil local. Sin esto Spring intentaria conectarse a Postgres.
SPRING_PROFILES_ACTIVE=local

# La app ya define una clave de desarrollo en application-local.yml.
# Para usar la tuya:
# JWT_SECRET=<pega aqui el resultado de: openssl rand -base64 48>

# Contrasena del administrador inicial que se crea al primer arranque.
BOOTSTRAP_ADMIN_PASSWORD=cambia-esta-clave

# ---- SUPABASE (solo para probar contra la base real) ----
# OJO: usa SIEMPRE el connection pooler (puerto 6543), no el directo (5432).
# El modo "session" (5432) agota las conexiones disponibles de Supabase.
# El direct URL (5432) solo lo necesita Flyway, que se ejecuta al inicio.
#   Pooler:  postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Direct: postgresql://postgres.<ref>:<clave>@db.<ref>.supabase.co:5432/postgres
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres
# SPRING_DATASOURCE_USERNAME=postgres.<ref>
# SPRING_DATASOURCE_PASSWORD=<tu-clave>

# ---- PRODUCCION (los mismos, pero en Railway como variables de entorno) ----
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://<pooler-host>:6543/postgres
# SPRING_DATASOURCE_USERNAME=postgres.<ref>
# SPRING_DATASOURCE_PASSWORD=<clave-de-la-base>
# JWT_SECRET=<openssl rand -base64 48>
# BOOTSTRAP_ADMIN_PASSWORD=<clave-del-admin-inicial>
# ALLOWED_ORIGINS=https://<tu-frontend>.vercel.app
